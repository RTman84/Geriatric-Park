# Build settings for the native Android bundle (`npm run build:native`). Nothing secret here.
# Backend the app talks to. Point at the production URL once `main` has the phase2 backend;
# until then this is the phase2 preview alias.
VITE_API_BASE_URL=https://geriatric-park-1-git-phase2-account-backend-517cab-reisun-abel.vercel.app
# AdMob rewarded ad unit. Leave commented to use Google's test ad until the AdMob app is approved,
# then set both lines (see ANDROID_SETUP.md).
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# VITE_ADMOB_PRODUCTION=true
