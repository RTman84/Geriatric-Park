# Build settings for the native Android bundle (`npm run build:native`). Nothing secret here.
# Backend the app talks to: the live Production deployment (main has the full backend since 2026-11-13).
VITE_API_BASE_URL=https://geriatric-park-1.vercel.app
# AdMob rewarded ad unit (public id, not a secret). It is only USED when VITE_ADMOB_PRODUCTION=true, which only the release build sets
# (`npm run build:native:release`); debug builds always show Google's test ad. Do NOT set VITE_ADMOB_PRODUCTION here.
VITE_ADMOB_REWARDED_ID=ca-app-pub-4749065898882415/9578911384
